# =====================================================================
# PYTHON REFERENCE PIPELINE
# ---------------------------------------------------------------------
# Python analog of `ci.yml.template` (the Go reference pipeline).
# `bootstrap.sh` activates THIS file as `.github/workflows/ci.yml` when
# the primary stack is `python`, and removes the Go `ci.yml.template`.
#
# Same job-shape as the Go template — paths-filter -> gated jobs ->
# fail-closed `ci-pass` aggregator, with cache + concurrency
# cancellation — only the language steps differ (uv + ruff + pytest
# instead of go build/vet/test + golangci-lint). Uses `uv` for env and
# dependency management; swap the `uv` steps for pip/poetry if your
# project uses those. Assumes a `pyproject.toml` at the repo root.
#
# The Python build/test/lint jobs are gated on the `python` paths filter,
# so a metadata-only PR (or a repo with no Python code yet) skips them and
# `ci-pass` still runs and passes. `actionlint` is gated on workflow
# changes. Make `ci-pass` the single required status check in branch
# protection — never the individual gated jobs (a skipped required check
# blocks the PR forever). bootstrap.sh wires this for the python stack.
# =====================================================================

name: CI

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  # GitHub merge queue re-runs CI against the queued PR rebased onto
  # post-previous-merge `main`. Harmless when the queue is off.
  merge_group:
    types: [checks_requested]

permissions:
  contents: read
  pull-requests: read

# Cancel an in-flight run on the same ref when a fresh push lands — saves
# CI minutes during agent-driven workflows with rapid successive pushes.
concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # Per-job paths filter. `python` gates the language jobs; `workflows`
  # gates actionlint. Add filters here as project-specific jobs (e2e,
  # migrations, etc.) are added, and consume them via `needs.paths.outputs`.
  paths:
    runs-on: ubuntu-latest
    outputs:
      python: ${{ steps.f.outputs.python }}
      workflows: ${{ steps.f.outputs.workflows }}
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
      - uses: dorny/paths-filter@d1c1ffe0248fe513906c8e24db8ea791d46f8590 # v3
        id: f
        with:
          filters: |
            python:
              - '**/*.py'
              - '**/pyproject.toml'
              - '**/uv.lock'
              - '**/requirements*.txt'
            workflows:
              - '.github/workflows/**'

  test:
    runs-on: ubuntu-latest
    needs: paths
    if: needs.paths.outputs.python == 'true'
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
      - name: Set up uv + Python
        uses: astral-sh/setup-uv@11f9893b081a58869d3b5fccaea48c9e9e46f990 # v8.3.2
        with:
          python-version: '3.11'
          enable-cache: true
      - name: Install dependencies
        run: uv sync --all-extras --dev
      - name: Test
        run: |
          set +e
          uv run pytest -q
          code=$?
          set -e
          # pytest exit 5 = "no tests collected" — legitimate for an early
          # slice with code but no tests yet. Treat as pass; any other
          # non-zero is a real failure.
          if [ "$code" -eq 5 ]; then
            echo "pytest: no tests collected yet — passing."
          elif [ "$code" -ne 0 ]; then
            exit "$code"
          fi

  lint:
    runs-on: ubuntu-latest
    needs: paths
    if: needs.paths.outputs.python == 'true'
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
      - name: Set up uv + Python
        uses: astral-sh/setup-uv@11f9893b081a58869d3b5fccaea48c9e9e46f990 # v8.3.2
        with:
          python-version: '3.11'
          enable-cache: true
      - name: Install dependencies
        run: uv sync --all-extras --dev
      - name: Ruff lint
        run: uv run ruff check .
      - name: Ruff format check
        run: uv run ruff format --check .

  # actionlint — workflow YAML linter. Language-agnostic; gated on workflow
  # changes. Supply-chain policy (SECURITY.md): download the pinned release
  # artifact and verify it against the published checksums before running —
  # no `curl | bash` of a remote script.
  actionlint:
    runs-on: ubuntu-latest
    needs: paths
    if: needs.paths.outputs.workflows == 'true'
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
      - name: Run actionlint
        env:
          ACTIONLINT_VERSION: 1.7.7
        run: |
          base="https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}"
          tarball="actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz"
          curl -sSfL -o "$tarball" "${base}/${tarball}"
          curl -sSfL -o actionlint_checksums.txt "${base}/actionlint_${ACTIONLINT_VERSION}_checksums.txt"
          grep " ${tarball}$" actionlint_checksums.txt | sha256sum -c -
          tar -xzf "$tarball" actionlint
          ./actionlint -color

  # Aggregator — the single overall CI signal and the check to require in
  # branch protection. FAIL-CLOSED: a non-success `paths` result is a hard
  # failure (the skip decisions become untrustworthy), and any gated job
  # that failed or was cancelled fails the aggregate. A *skipped* gated job
  # is OK — its paths were not touched.
  ci-pass:
    runs-on: ubuntu-latest
    needs: [paths, test, lint, actionlint]
    if: always()
    steps:
      - name: Aggregate
        run: |
          echo "  paths: ${{ needs.paths.result }}"
          if [ "${{ needs.paths.result }}" != "success" ]; then
            echo "ci-pass: FAILED — the paths filter job did not succeed; gating is unreliable."
            exit 1
          fi
          failed=0
          for job in test lint actionlint; do
            case "$job" in
              test)       r="${{ needs.test.result }}" ;;
              lint)       r="${{ needs.lint.result }}" ;;
              actionlint) r="${{ needs.actionlint.result }}" ;;
            esac
            echo "  $job: $r"
            if [ "$r" = "failure" ] || [ "$r" = "cancelled" ]; then
              failed=1
            fi
          done
          if [ "$failed" -eq 1 ]; then
            echo "ci-pass: FAILED — a gated job failed or was cancelled."
            exit 1
          fi
          echo "ci-pass: OK (paths succeeded; all gated jobs passed or were skipped)."
